   setup:
     accel                             : ONEMATH # Material Acceleration
     use_gpu_direct                    : Yes #    Force (or not) the usage of GPUdirect communication, if available
     verbose                           : Yes #    Verbosity switch
     keep_gpu_memory                   : Yes #    Do not deallocate GPU memory at each call of the (G)PS routine
     taskgroup_size                    : 0 #      Size of the taskgroups of the Poisson Solver
     global_data                       : No #     Charge density and Electrostatic potential are given by global arrays
     minres                            : 1.e-8 #  Convergence threshold of the loop
     pb_method                         : none #   Defines the method for the Poisson Boltzmann Equation
   MPI tasks                           :  1
   OpenMP threads per MPI task         :  28
   Poisson Solver GPU Enumerator:
     BACKEND                           :  4
     Attributes:
       DEVICE                          :  0
       MODEL                           :  2
